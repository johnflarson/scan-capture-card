# Settings for tome-collector. Copy to collector.env (kept out of git) and fill in.

# The metrics page's password (any user name). Without it the page is off;
# pings are still received. Use a long random one.
TOME_COLLECTOR_PASSWORD=

# A GitHub token for page views, visitors, clones and sponsors (stars,
# releases and image pulls work without one). A fine-grained token with
# read-only access to the repository's "Administration" permission is enough.
GITHUB_TOKEN=

# The repository and the sponsored account (defaults shown).
# TOME_COLLECTOR_REPO=johnflarson/scan-capture-card
# TOME_COLLECTOR_SPONSOR=johnflarson

# Where the web server puts the collector; compose.yaml sets /app/shufflingtome.
# Empty when the web server strips the path.
# TOME_COLLECTOR_BASE_PATH=/app/shufflingtome

# Rate limits use the address in X-Forwarded-For / X-Real-IP. Set to false
# when nothing in front of the collector sets those headers.
# TOME_COLLECTOR_TRUST_PROXY=true
