# mtg-scan secrets and connection settings.
# Copy to `.env` next to mtg-scan.toml (or %APPDATA%\mtg-scan\.env) and fill in.
# `.env` is git-ignored. Values are taken literally: everything after the `=`
# ($, #, \ and quotes inside a value are kept; no URL-encoding). Surrounding
# whitespace is trimmed; wrap a value in quotes only to keep edge spaces.
# Real environment variables, if set, take precedence over this file.

# --- PostgreSQL (used when [storage] backend = "postgres") ---
MTG_SCAN_DB_HOST=localhost
MTG_SCAN_DB_PORT=5432
MTG_SCAN_DB_USER=
MTG_SCAN_DB_PASSWORD=
# Defaults to the user name when empty.
MTG_SCAN_DB_NAME=
# disable | prefer | require   (prefer = use TLS if the server offers it)
MTG_SCAN_DB_SSLMODE=prefer

# Alternatively, one connection string (overrides the MTG_SCAN_DB_* values):
# MTG_SCAN_DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Vision LLM API keys (only for cloud providers) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
