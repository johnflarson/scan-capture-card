# mtg-scan secrets and connection settings.
# Copy to `.env` next to mtg-scan.toml (or %APPDATA%\mtg-scan\.env) and fill in.
# `.env` is git-ignored. Values are taken literally: everything after the `=`
# ($, #, \ and quotes inside a value are kept; no URL-encoding). Surrounding
# whitespace is trimmed; wrap a value in quotes only to keep edge spaces.
# Real environment variables, if set, take precedence over this file.

# --- PostgreSQL (used when [storage] backend = "postgres") ---
MTG_SCAN_DB_HOST=localhost
MTG_SCAN_DB_PORT=5432
MTG_SCAN_DB_USER=
MTG_SCAN_DB_PASSWORD=
# Defaults to the user name when empty.
MTG_SCAN_DB_NAME=
# disable | prefer | require   (prefer = use TLS if the server offers it)
MTG_SCAN_DB_SSLMODE=prefer

# Alternatively, one connection string (overrides the MTG_SCAN_DB_* values):
# MTG_SCAN_DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Moxfield decks (web UI Decks page) ---
# A Moxfield user name or profile link; their public decks are listed.
# Easier: enter it on the web UI's Settings page (saved in mtg-scan.toml, which
# wins over this line).
# MTG_SCAN_MOXFIELD_USER=https://moxfield.com/users/YourName

# --- Vision LLM API keys (only for cloud providers) ---
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- Settings as variables (handy with Docker; the command-line flags win) ---
# Like --storage (sqlite | postgres), --llm-provider, --llm-model,
# --llm-base-url, and the port of `ui` and `health`:
# MTG_SCAN_STORAGE=postgres
# MTG_SCAN_LLM_PROVIDER=ollama
# MTG_SCAN_LLM_MODEL=qwen3-vl:8b-instruct
# MTG_SCAN_LLM_BASE_URL=http://ollama:11434
# MTG_SCAN_PORT=8787

# --- Docker Compose only (compose.yaml) ---
# Reachable from other computers (set MTG_SCAN_UI_TOKEN too):
# MTG_SCAN_PUBLISH=0.0.0.0
# Which published image to run:
# MTG_SCAN_IMAGE_TAG=latest
